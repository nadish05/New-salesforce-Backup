    <decisions>
        <name>Check_Time_Conflict</name>
        <label>Check Time Conflict</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Trainer_Sessions</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Conflict_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Start_Time__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Loop_Trainer_Sessions.End_Time__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.End_Time__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Loop_Trainer_Sessions.Start_Time__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trainer_error</targetReference>
            </connector>
            <label>Conflict Found</label>
        </rules>
    </decisions>
