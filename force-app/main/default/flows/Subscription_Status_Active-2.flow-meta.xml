<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Payment_Completed</name>
        <label>Payment Completed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Subscription_Fully_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subscription__r.Total_Amount_Paid__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Amount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_Status</targetReference>
            </connector>
            <label>Subscription Fully Paid?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Multipay</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Subscription__r.Total_Amount_Paid__c}+ {!$Record.Amount_Paid__c}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Subscription Status Active {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subscription Status Active</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Multiple_Payment</name>
        <label>Multiple Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Payment_Completed</targetReference>
        </connector>
        <inputAssignments>
            <field>Total_Amount_Paid__c</field>
            <value>
                <elementReference>Multipay</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Subscription__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>update_Status</name>
        <label>update Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Subscription__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Multiple_Payment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Payment_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <object>Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
